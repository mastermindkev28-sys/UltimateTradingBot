# ══════════════════════════════════════════════════════════════════════
# UltimateTradingBot v3 — Environment Variables
# Copy to .env and fill in real values.  NEVER commit .env.
# ══════════════════════════════════════════════════════════════════════

# ── Operating Mode ──────────────────────────────────────────────────
# true  = paper/demo trading (SAFE DEFAULT)
# false = live trading (DANGER — verify everything first)
DEMO_MODE=true

# ── Tradovate Credentials ────────────────────────────────────────────
# Settings → API Access → Create Application
TRADOVATE_USERNAME=your_tradovate_username
TRADOVATE_PASSWORD=your_tradovate_password
TRADOVATE_APP_ID=your_app_id_from_tradovate
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=your_cid_number
TRADOVATE_SECRET=your_api_secret

# ── Telegram Alerts (outbound — bot sends alerts TO this chat) ────────
TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNooP
TELEGRAM_CHAT_ID=-1001234567890

# ── Telegram Signal Receiver (inbound — bot READS signals FROM here) ──
# The chat or channel ID from which the bot accepts trading signals.
# Must match the chat where @Quant_PF_signals_bot posts.
# Set to your operator Telegram user ID or the signal channel ID.
# Get chat ID: forward a message from the channel to @userinfobot
TELEGRAM_SIGNAL_CHAT_ID=-1009876543210

# Long-poll timeout in seconds (25 is optimal for near-instant delivery)
TELEGRAM_POLL_TIMEOUT=25

# ── Webhook Server (TradingView → bot) ───────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace_with_long_random_hex_string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ── Dashboard Server ──────────────────────────────────────────────────
# Web dashboard URL: http://YOUR_SERVER_IP:8088
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_PASSWORD=changeme_use_a_strong_password
DASHBOARD_PORT=8088

# ── Instrument ───────────────────────────────────────────────────────
DEFAULT_INSTRUMENT=MGC

# ── Risk ─────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=0.003
DAILY_LOSS_LIMIT_PCT=0.0085
DAILY_PROFIT_TARGET_PCT=0.012
MAX_TRADES_PER_DAY=3
SL_ATR_DEFAULT=1.0

# ── Strategy ─────────────────────────────────────────────────────────
OR_MIN_RANGE_POINTS=1.5

# ── Prop Firm ─────────────────────────────────────────────────────────
# topstep_50k | topstep_100k | topstep_150k | mff_50k | mff_100k | lucid_50k | lucid_100k
PROP_FIRM=topstep_50k

# ── News Filter ──────────────────────────────────────────────────────
NEWS_BLACKOUT_BEFORE_MIN=45
NEWS_BLACKOUT_AFTER_MIN=45
STRICT_NEWS_FILTER=false
MANUAL_NEWS_TIMES=

# ════════════════════════════════════════════════════════════════════════════
# ORDER FLOW FILTER  (v2)
# ════════════════════════════════════════════════════════════════════════════
#
# RECOMMENDED ROLL-OUT SEQUENCE:
#   Phase 1 (weeks 1-2): ORDER_FLOW_ENABLED=false
#     → Run the bot, collect baseline data on signal quality
#   Phase 2 (weeks 3-4): Enable with loose thresholds
#     → ORDER_FLOW_ENABLED=true
#     → OF_REQUIRE_POSITIVE_DELTA=true, OF_REQUIRE_BAR_DELTA=true
#     → OF_ALLOW_MISSING_DATA=true (don't block if TradingView doesn't send OF)
#   Phase 3 (after 30+ trades): Tighten based on what helped
#     → Optionally add OF_REQUIRE_ABSORPTION=true for extra confirmation
#
# ─── Master switch ──────────────────────────────────────────────────
ORDER_FLOW_ENABLED=false

# ─── Individual conditions (only evaluated when ORDER_FLOW_ENABLED=true) ─
# Require session cumulative delta to agree with trade direction
OF_REQUIRE_POSITIVE_DELTA=true

# Require the breakout bar's delta to agree with direction
OF_REQUIRE_BAR_DELTA=true

# Require bid/ask imbalance (reliable only with true Level II data)
OF_REQUIRE_IMBALANCE=false

# Require absorption event at OR boundary (powerful but rare)
OF_REQUIRE_ABSORPTION=false

# Reject if price and delta are diverging (conservative filter)
OF_REQUIRE_NO_DIVERGENCE=false

# ─── Numeric thresholds ─────────────────────────────────────────────
# Minimum cumulative delta magnitude (0 = any agreeing sign)
OF_MIN_CUMULATIVE_DELTA=0

# Minimum bar delta magnitude (0 = any agreeing sign)
OF_MIN_BAR_DELTA=0

# Minimum bid/ask imbalance (0.0–1.0 scale)
OF_IMBALANCE_THRESHOLD=0.20

# Minimum absorption strength (0.0–1.0 scale)
OF_MIN_ABSORPTION_STRENGTH=0.50

# Minimum consecutive agreeing delta bars (0 = disabled)
OF_MIN_DELTA_TREND_BARS=0

# ─── Missing data handling ───────────────────────────────────────────
# true  = allow trade if TradingView doesn't send OF fields (fail-open)
# false = block trade if OF fields missing (fail-safe, stricter)
OF_ALLOW_MISSING_DATA=true

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
DAILY_REPORT_DIR=logs/daily_reports
