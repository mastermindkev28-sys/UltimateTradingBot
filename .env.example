# ══════════════════════════════════════════════════════════════════════
# UltimateTradingBot — Environment Variables
# Copy this file to  .env  and fill in your real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════

# ── Operating Mode ──────────────────────────────────────────────────
# true  = paper/demo trading (SAFE DEFAULT — always start here)
# false = live trading with real money (DANGER — verify everything first)
DEMO_MODE=true

# ── Tradovate Credentials ────────────────────────────────────────────
# Create a Tradovate account → Settings → API Access → Create Application
TRADOVATE_USERNAME=your_tradovate_username
TRADOVATE_PASSWORD=your_tradovate_password
TRADOVATE_APP_ID=your_app_id_from_tradovate
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=your_cid_number
TRADOVATE_SECRET=your_api_secret

# ── Telegram Alerts ──────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Open your bot → send a message → visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat_id
TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNooP
TELEGRAM_CHAT_ID=-1001234567890

# ── Webhook Server (TradingView → Bot) ───────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace_this_with_a_long_random_secret_string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ── Trading Instrument ───────────────────────────────────────────────
# MGC = Micro Gold ($10/point) — USE THIS for prop firm evaluations
# GC  = Gold ($100/point)     — large accounts only
DEFAULT_INSTRUMENT=MGC

# ── Risk Parameters ──────────────────────────────────────────────────
# Risk per trade as a decimal (0.003 = 0.30%)
RISK_PER_TRADE_PCT=0.003

# Hard daily loss limit (0.0085 = 0.85%)
DAILY_LOSS_LIMIT_PCT=0.0085

# Daily profit target — stop trading when reached (0.012 = 1.20%)
DAILY_PROFIT_TARGET_PCT=0.012

# Maximum trades per day
MAX_TRADES_PER_DAY=3

# Stop-loss ATR multiplier (1.0 = 1× ATR)
SL_ATR_DEFAULT=1.0

# ── Opening Range ────────────────────────────────────────────────────
# Minimum range width in points (skip day if too narrow / choppy)
OR_MIN_RANGE_POINTS=1.5

# ── Prop Firm Preset ─────────────────────────────────────────────────
# Supported: topstep_50k, topstep_100k, topstep_150k,
#            mff_50k, mff_100k, lucid_50k, lucid_100k
PROP_FIRM=topstep_50k

# ── News Filter ──────────────────────────────────────────────────────
# Block trading this many minutes before/after high-impact events
NEWS_BLACKOUT_BEFORE_MIN=45
NEWS_BLACKOUT_AFTER_MIN=45

# Fail-safe: block ALL trading when news calendar is unavailable
STRICT_NEWS_FILTER=false

# Manually add event times in ET (comma-separated HH:MM)
# Example: MANUAL_NEWS_TIMES=08:30,14:00
MANUAL_NEWS_TIMES=

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
DAILY_REPORT_DIR=logs/daily_reports
